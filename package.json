    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
