# Sao chép thành .env (KHÔNG commit). Repo public: không đặt mật khẩu thật vào file này.
DATABASE_URL=postgresql://portal:CHANGE_ME@postgres:5432/portal
POSTGRES_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
ADMIN_USER=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME   # chỉ dùng khi seed; bắt đổi ở lần đăng nhập đầu
UPLOAD_DIR=/data/uploads

# Sau gateway/proxy (nginx, Cloudflare): bật để lấy IP khách cho rate limit đăng nhập. Không bật nếu portal
# nghe trực tiếp ra Internet (header giả được). Tắt thì mọi người dùng chung IP "unknown".
TRUST_PROXY=1
# Header chứa IP khách khi TRUST_PROXY=1 (mặc định x-forwarded-for, lấy phần tử đầu; Cloudflare: cf-connecting-ip)
CLIENT_IP_HEADER=x-forwarded-for
# Cookie luôn Secure (không phụ thuộc X-Forwarded-Proto). NODE_ENV=production cũng ghim Secure.
COOKIE_SECURE=1
