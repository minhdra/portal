# Sao chép thành .env (KHÔNG commit). Repo public: không đặt mật khẩu thật vào file này.
DATABASE_URL=postgresql://portal:CHANGE_ME@postgres:5432/portal
POSTGRES_PASSWORD=CHANGE_ME
# Tối thiểu 32 ký tự ngẫu nhiên (vd: openssl rand -base64 48). Dùng ký cookie "thiết bị quen" (ADR 0002).
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_AT_LEAST_32_CHARS
ADMIN_USER=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME   # chỉ dùng khi seed; bắt đổi ở lần đăng nhập đầu
UPLOAD_DIR=/data/uploads

# ---- IP khách (rate limit đăng nhập). Chuỗi triển khai: Cloudflare tunnel -> gateway nginx -> portal. ----
# Portal KHÔNG publish cổng ra host: chỉ gateway chạm được. Gateway dùng real_ip_header CF-Connecting-IP rồi ĐẶT
# (ghi đè, không append) `proxy_set_header X-Client-IP $remote_addr;`. Portal tin nguyên giá trị header đó.
# Mặc định đúng cho chuỗi trên. KHÔNG bật TRUST_PROXY nếu portal nghe trực tiếp ra Internet (header giả được).
# TRUST_PROXY tắt: mọi người dùng chung IP "unknown" (khoá theo IP bị tắt, chỉ còn làm chậm theo username);
# production sẽ in cảnh báo khi khởi động.
TRUST_PROXY=1
# Tuỳ chọn: x-client-ip (mặc định) | cf-connecting-ip | x-forwarded-for (lấy phần tử CUỐI).
CLIENT_IP_HEADER=x-client-ip
# Cookie luôn Secure (không phụ thuộc X-Forwarded-Proto). NODE_ENV=production cũng ghim Secure.
COOKIE_SECURE=1

# Node có 4 luồng libuv dùng chung cho fs/dns/zlib; argon2 chiếm tối đa 2. Máy nhiều nhân: đặt biến này trong
# môi trường container (docker-compose `environment:`), không phải ở file này nếu Docker không nạp .env cho tiến trình.
# UV_THREADPOOL_SIZE=8

# ---- Docker compose (xem docs/DEPLOY.md) ----
# Gateway nginx chỉ lắng nghe 127.0.0.1 (tunnel/Cloudflare trỏ vào đây).
GATEWAY_PORT=18790
# Mặc định chỉ nghe 127.0.0.1. Khi đứng sau proxy router: GATEWAY_BIND=<IP LAN máy> và GATEWAY_PORT=18780 (xem docs/DEPLOY.md mục 7).
# GATEWAY_BIND=127.0.0.1
# Backup hằng ngày (pg_dump + tar uploads), xoay vòng. BACKUP_HOUR theo UTC.
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_HOUR=3
BACKUP_UID=1000
BACKUP_GID=1000
# DATABASE_URL ở trên bị docker-compose ghép lại từ POSTGRES_PASSWORD (không cần chỉnh khi chạy compose).
